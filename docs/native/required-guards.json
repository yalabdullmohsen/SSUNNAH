{
  "_": "حراس لازمة قبل أي RC نهائي (طلب المالك 2026-10-16). match = تعبير على اسم ملف تحت scripts/ يبدأ بـnative-؛ كل حارس يجب أن يُستدعى في scripts/native-release-check.sh بسطر فيه «bad» أو «|| fail=1» (ليفشل الفحص عند المخالفة). عدّلوا match إن اختلف اسم حارسكم.",
  "guards": [
    {
      "id": "titles-unique",
      "owner": "ن1",
      "match": "native-.*(title|heading).*\\.(mjs|sh)$"
    },
    {
      "id": "date-readable",
      "owner": "ن1",
      "match": "native-.*date.*\\.(mjs|sh)$"
    },
    {
      "id": "tabbar-cover",
      "owner": "ن1",
      "match": "native-tabbar-cover-guard\\.mjs$"
    },
    {
      "id": "verse-selection",
      "owner": "ن3",
      "match": "native-.*(verse|selection|ayah).*\\.(mjs|sh)$",
      "finalOnly": true
    },
    {
      "id": "mushaf-disc",
      "owner": "ن3",
      "match": "native-mushaf-disc-guard\\.sh$"
    },
    {
      "id": "disc-asym-threshold",
      "owner": "ن3",
      "match": "native-mushaf-disc-guard\\.sh$"
    },
    {
      "id": "mushaf-endmark",
      "owner": "ن3",
      "match": "native-mushaf-endmark-guard\\.sh$"
    },
    {
      "id": "verse-selection",
      "owner": "ن3",
      "match": "native-mushaf-verse-selection-guard\\.sh$"
    },
    {
      "id": "mushaf-basmala",
      "owner": "ن3",
      "match": "native-mushaf-basmala-guard\\.sh$"
    },
    {
      "id": "shot-provenance",
      "owner": "ن3",
      "match": "native-shot-provenance-guard\\.sh$"
    },
    {
      "id": "pager-two-pages",
      "owner": "ن3",
      "match": "native-mushaf-pager-guard\\.sh$"
    },
    {
      "id": "templated-content",
      "owner": "ن2",
      "match": "native-content-guards\\.mjs$"
    },
    {
      "id": "watch-assets",
      "owner": "ن4",
      "match": "native-watch-assets-guard\\.sh$"
    },
    {
      "id": "mushaf-verse-selection",
      "owner": "ن3",
      "match": "native-mushaf-verse-selection-guard\\.sh$"
    },
    {
      "id": "watch-auth",
      "owner": "ن1",
      "match": "native-watch-auth-guard\\.sh$"
    },
    {
      "id": "sensitive-coverage",
      "owner": "ن4",
      "match": "native-sensitive-coverage\\.sh$"
    },
    {
      "id": "shipping-no-capacitor",
      "owner": "ن4",
      "match": "native-shipping-workflow-guard\\.sh$"
    },
    {
      "id": "assets-license",
      "owner": "ن4",
      "match": "native-assets-license-guard\\.sh$"
    },
    {
      "id": "assets-size",
      "owner": "ن4",
      "match": "native-assets-size-guard\\.sh$"
    }
  ]
}
