{
	"appId": "com.yousef.majlisilm",
	"appName": "سُنّة",
	"webDir": "dist",
	"server": {
		"cleartext": false,
		"allowNavigation": [
			"www.ssunnah.com",
			"ssunnah.com",
			"majlisilm.com",
			"www.majlisilm.com"
		],
		"url": "https://www.ssunnah.com",
		"errorPath": "native-load-error.html"
	},
	"plugins": {
		"SplashScreen": {
			"launchShowDuration": 0,
			"launchAutoHide": false,
			"backgroundColor": "#F8F6F1",
			"showSpinner": false,
			"splashImmersive": true,
			"splashFullScreen": true
		},
		"StatusBar": {
			"style": "DARK",
			"backgroundColor": "#F8F6F1",
			"overlaysWebView": true
		},
		"Keyboard": {
			"resize": "body",
			"resizeOnFullScreen": true
		},
		"LocalNotifications": {
			"presentationOptions": [
				"badge",
				"sound",
				"banner",
				"list"
			]
		},
		"PushNotifications": {
			"presentationOptions": [
				"badge",
				"sound",
				"banner",
				"list"
			]
		}
	},
	"ios": {
		"contentInset": "never",
		"backgroundColor": "#F8F6F1",
		"scrollEnabled": true
	}
}
