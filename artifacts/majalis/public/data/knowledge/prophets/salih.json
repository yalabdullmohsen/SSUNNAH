      "title": "التعريف",
      "body": "صالح عليه السلام — نبي أُرسل إلى ثمود.",
      "ayahRef": [
        {
          "surah": 7,
          "from": 73,
          "to": 73
        }
      ],
      "sources": [
        {
          "author": "القرآن الكريم",
          "book": "المصحف (رسم عثماني)",
