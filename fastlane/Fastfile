# frozen_string_literal: true

default_platform(:ios)

PLATFORM_ROOT = File.expand_path("..", __dir__)
IOS_PROJECT = File.join(PLATFORM_ROOT, "artifacts/majalis/ios/App/App.xcodeproj")
IOS_WORKSPACE_DIR = File.join(PLATFORM_ROOT, "artifacts/majalis/ios/App")
SCHEME = "App"
OUTPUT_DIR = File.join(PLATFORM_ROOT, "artifacts/majalis/ios/build")

platform :ios do
  desc "Build, sign, and upload to TestFlight (ASC API Key JWT)"
  lane :beta do
    UI.header("Majalis Al-Ilm — TestFlight beta")

    begin
      # CI: محتوى .p8 بـBase64 في APP_STORE_CONNECT_API_KEY_KEY.
      # محليًا: مسار ملف .p8 خارج المستودع في APP_STORE_CONNECT_API_KEY_PATH.
      key_path = ENV["APP_STORE_CONNECT_API_KEY_PATH"].to_s.strip
      key_source = if key_path.empty?
                     { key_content: ENV.fetch("APP_STORE_CONNECT_API_KEY_KEY"), is_key_content_base64: true }
                   else
                     # الإجراء يربط :key_content تلقائيًا بـAPP_STORE_CONNECT_API_KEY_KEY ويقدّمه على
                     # :key_filepath، فيُقرأ Base64 الخام كـPEM («invalid curve name»). الملف المفكوك هو المصدر الوحيد.
                     ENV.delete("APP_STORE_CONNECT_API_KEY_KEY")
                     ENV.delete("APP_STORE_CONNECT_API_KEY_IS_KEY_CONTENT_BASE64")
                     { key_filepath: File.expand_path(key_path) }
                   end
      api_key = app_store_connect_api_key(
        key_id: ENV.fetch("APP_STORE_CONNECT_API_KEY_ID"),
        issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
        duration: 1200,
        in_house: false,
        **key_source
      )

      app_id = ENV.fetch("APP_IDENTIFIER", "com.yousef.majlisilm")
      changelog = ENV["TESTFLIGHT_CHANGELOG"].to_s.strip
      changelog = "Automated TestFlight build from GitHub Actions (#{Time.now.utc.iso8601})" if changelog.empty?

      UI.message("Resolving latest TestFlight build number for #{app_id}…")
      latest = begin
        latest_testflight_build_number(
          api_key: api_key,
          app_identifier: app_id,
          initial_build_number: 0
        )
      rescue StandardError => e
        UI.important("Could not read TestFlight build number (#{e.message}); starting from 0")
        0
      end
      # الحد الأدنى من رقم تشغيل CI يضمن الزيادة حتى لو تعذّرت قراءة آخر بناء من Apple
      next_build = [latest.to_i + 1, ENV["CI_BUILD_NUMBER"].to_i].max
      UI.success("Next build number: #{next_build}")

      increment_build_number(
        build_number: next_build,
        xcodeproj: IOS_PROJECT
      )

      Dir.chdir(IOS_WORKSPACE_DIR) do
        UI.message("Resolving Swift Package Manager dependencies…")
        sh(
          "xcodebuild",
          "-resolvePackageDependencies",
          "-project", "App.xcodeproj",
          "-scheme", SCHEME
        )
      end

      FileUtils.mkdir_p(OUTPUT_DIR)

      # شاشة قياس «تسميع» المخفية: TASMEE_DIAGNOSTICS=1 يجمّع شيفرة القياس في Swift (شرط بناء) ولا يُفعَّل لبناء App Store.
      # الجزء JS يحتاج VITE_TASMEE_DIAGNOSTICS=1 عند بناء الويب قبل cap sync (انظر docs/tasmee/TESTFLIGHT.md).
      diagnostics = ENV["TASMEE_DIAGNOSTICS"].to_s == "1"
      UI.important("بناء قياس التسميع (TASMEE_DIAGNOSTICS) — للـTestFlight الداخلي فقط، لا يُرسَل لمراجعة App Store") if diagnostics
      # $(inherited) إلزامي: تعيين الشرط وحده يمحو شروط الحزم (swift-crypto: unable to resolve module dependency)
      swift_flags = diagnostics ? " SWIFT_ACTIVE_COMPILATION_CONDITIONS='$(inherited) TASMEE_DIAGNOSTICS'" : ""
      # التوقيع السحابي على مشغّل نظيف يحتاج مصادقة xcodebuild بمفتاح ASC نفسه
      signing_xcargs = "-allowProvisioningUpdates"
      unless key_path.empty?
        signing_xcargs += " -authenticationKeyPath #{File.expand_path(key_path)}" \
                          " -authenticationKeyID #{ENV.fetch('APP_STORE_CONNECT_API_KEY_ID')}" \
                          " -authenticationKeyIssuerID #{ENV.fetch('APP_STORE_CONNECT_ISSUER_ID')}"
      end

      build_app(
        project: IOS_PROJECT,
        scheme: SCHEME,
        clean: true,
        silent: false,
        output_directory: OUTPUT_DIR,
        output_name: "MajlisIlm",
        export_method: "app-store",
        # gym يمرّر xcargs إلى -exportArchive أيضًا؛ تكرارها في export_xcargs يُفشل التصدير
        # («-authenticationKeyPath may only be provided once»).
        xcargs: "#{signing_xcargs}#{swift_flags}",
        buildlog_path: File.join(OUTPUT_DIR, "logs"),
        result_bundle: true,
        result_bundle_path: File.join(OUTPUT_DIR, "MajlisIlm.xcresult"),
        skip_profile_detection: false,
        export_options: {
          method: "app-store",
          signingStyle: "automatic",
          teamID: ENV.fetch("APPLE_TEAM_ID", "5D8TX37HTS"),
          uploadBitcode: false,
          uploadSymbols: true,
          compileBitcode: false
        }
      )

      upload_to_testflight(
        api_key: api_key,
        app_identifier: app_id,
        ipa: File.join(OUTPUT_DIR, "MajlisIlm.ipa"),
        skip_waiting_for_build_processing: true,
        skip_submission: true,
        distribute_external: false,
        notify_external_testers: false,
        changelog: changelog,
        apple_id: ENV["ITC_APPLE_ID"]
      )

      UI.success("TestFlight upload completed (build #{next_build})")
    rescue StandardError => e
      UI.error("beta lane failed: #{e.class}: #{e.message}")
      UI.error(e.backtrace&.first(12)&.join("\n").to_s)
      raise e
    ensure
      UI.message("Cleaning intermediate DerivedData for this lane…")
      sh("rm", "-rf", File.join(OUTPUT_DIR, "logs")) if File.directory?(File.join(OUTPUT_DIR, "logs"))
    end
  end

  desc "Local archive smoke (no upload) — useful for CI dry-run on macOS"
  lane :build_only do
    Dir.chdir(IOS_WORKSPACE_DIR) do
      sh(
        "xcodebuild",
        "-resolvePackageDependencies",
        "-project", "App.xcodeproj",
        "-scheme", SCHEME
      )
    end

    build_app(
      project: IOS_PROJECT,
      scheme: SCHEME,
      clean: true,
      skip_package_ipa: true,
      skip_archive: false,
      destination: "generic/platform=iOS",
      xcargs: "CODE_SIGNING_ALLOWED=NO CODE_SIGNING_REQUIRED=NO CODE_SIGN_IDENTITY=''",
      output_directory: OUTPUT_DIR
    )
  end
end
