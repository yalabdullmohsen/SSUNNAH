# frozen_string_literal: true

default_platform(:ios)

PLATFORM_ROOT = File.expand_path("..", __dir__)
IOS_PROJECT = File.join(PLATFORM_ROOT, "artifacts/majalis/ios/App/App.xcodeproj")
IOS_WORKSPACE_DIR = File.join(PLATFORM_ROOT, "artifacts/majalis/ios/App")
SCHEME = "App"
OUTPUT_DIR = File.join(PLATFORM_ROOT, "artifacts/majalis/ios/build")

platform :ios do
  desc "Build, sign, and upload to TestFlight (ASC API Key JWT)"
  lane :beta do
    UI.header("Majalis Al-Ilm — TestFlight beta")

    begin
      # CI: محتوى .p8 بـBase64 في APP_STORE_CONNECT_API_KEY_KEY.
      # محليًا: مسار ملف .p8 خارج المستودع في APP_STORE_CONNECT_API_KEY_PATH.
      key_path = ENV["APP_STORE_CONNECT_API_KEY_PATH"].to_s.strip
      key_source = if key_path.empty?
                     { key_content: ENV.fetch("APP_STORE_CONNECT_API_KEY_KEY"), is_key_content_base64: true }
                   else
                     # الإجراء يربط :key_content تلقائيًا بـAPP_STORE_CONNECT_API_KEY_KEY ويقدّمه على
                     # :key_filepath، فيُقرأ Base64 الخام كـPEM («invalid curve name»). الملف المفكوك هو المصدر الوحيد.
                     ENV.delete("APP_STORE_CONNECT_API_KEY_KEY")
                     ENV.delete("APP_STORE_CONNECT_API_KEY_IS_KEY_CONTENT_BASE64")
                     { key_filepath: File.expand_path(key_path) }
                   end
      api_key = app_store_connect_api_key(
        key_id: ENV.fetch("APP_STORE_CONNECT_API_KEY_ID"),
        issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
        duration: 1200,
        in_house: false,
        **key_source
      )

      app_id = ENV.fetch("APP_IDENTIFIER", "com.yousef.majlisilm")
      changelog = ENV["TESTFLIGHT_CHANGELOG"].to_s.strip
      changelog = "Automated TestFlight build from GitHub Actions (#{Time.now.utc.iso8601})" if changelog.empty?

      UI.message("Resolving latest TestFlight build number for #{app_id}…")
      latest = begin
        latest_testflight_build_number(
          api_key: api_key,
          app_identifier: app_id,
          initial_build_number: 0
        )
      rescue StandardError => e
        UI.important("Could not read TestFlight build number (#{e.message}); starting from 0")
        0
      end
      # الحد الأدنى من رقم تشغيل CI يضمن الزيادة حتى لو تعذّرت قراءة آخر بناء من Apple
      next_build = [latest.to_i + 1, ENV["CI_BUILD_NUMBER"].to_i].max
      UI.success("Next build number: #{next_build}")

      increment_build_number(
        build_number: next_build,
        xcodeproj: IOS_PROJECT
      )

      Dir.chdir(IOS_WORKSPACE_DIR) do
        UI.message("Resolving Swift Package Manager dependencies…")
        sh(
          "xcodebuild",
          "-resolvePackageDependencies",
          "-project", "App.xcodeproj",
          "-scheme", SCHEME
        )
      end

      FileUtils.mkdir_p(OUTPUT_DIR)

      # شاشة قياس «تسميع» المخفية: TASMEE_DIAGNOSTICS=1 يجمّع شيفرة القياس في Swift (شرط بناء) ولا يُفعَّل لبناء App Store.
      # الجزء JS يحتاج VITE_TASMEE_DIAGNOSTICS=1 عند بناء الويب قبل cap sync (انظر docs/tasmee/TESTFLIGHT.md).
      diagnostics = ENV["TASMEE_DIAGNOSTICS"].to_s == "1"
      UI.important("بناء قياس التسميع (TASMEE_DIAGNOSTICS) — للـTestFlight الداخلي فقط، لا يُرسَل لمراجعة App Store") if diagnostics
      # $(inherited) إلزامي: تعيين الشرط وحده يمحو شروط الحزم (swift-crypto: unable to resolve module dependency)
      swift_flags = diagnostics ? " SWIFT_ACTIVE_COMPILATION_CONDITIONS='$(inherited) TASMEE_DIAGNOSTICS'" : ""
      # التوقيع السحابي على مشغّل نظيف يحتاج مصادقة xcodebuild بمفتاح ASC نفسه
      signing_xcargs = "-allowProvisioningUpdates"
      unless key_path.empty?
        signing_xcargs += " -authenticationKeyPath #{File.expand_path(key_path)}" \
                          " -authenticationKeyID #{ENV.fetch('APP_STORE_CONNECT_API_KEY_ID')}" \
                          " -authenticationKeyIssuerID #{ENV.fetch('APP_STORE_CONNECT_ISSUER_ID')}"
      end

      build_app(
        project: IOS_PROJECT,
        scheme: SCHEME,
        clean: true,
        silent: false,
        output_directory: OUTPUT_DIR,
        output_name: "MajlisIlm",
        export_method: "app-store",
        # gym يمرّر xcargs إلى -exportArchive أيضًا؛ تكرارها في export_xcargs يُفشل التصدير
        # («-authenticationKeyPath may only be provided once»).
        xcargs: "#{signing_xcargs}#{swift_flags}",
        buildlog_path: File.join(OUTPUT_DIR, "logs"),
        result_bundle: true,
        result_bundle_path: File.join(OUTPUT_DIR, "MajlisIlm.xcresult"),
        skip_profile_detection: false,
        export_options: {
          method: "app-store",
          signingStyle: "automatic",
          teamID: ENV.fetch("APPLE_TEAM_ID", "5D8TX37HTS"),
          uploadBitcode: false,
          uploadSymbols: true,
          compileBitcode: false
        }
      )

      upload_to_testflight(
        api_key: api_key,
        app_identifier: app_id,
        ipa: File.join(OUTPUT_DIR, "MajlisIlm.ipa"),
        skip_waiting_for_build_processing: true,
        skip_submission: true,
        distribute_external: false,
        notify_external_testers: false,
        changelog: changelog,
        apple_id: ENV["ITC_APPLE_ID"]
      )

      UI.success("TestFlight upload completed (build #{next_build})")
    rescue StandardError => e
      UI.error("beta lane failed: #{e.class}: #{e.message}")
      UI.error(e.backtrace&.first(12)&.join("\n").to_s)
      raise e
    ensure
      UI.message("Cleaning intermediate DerivedData for this lane…")
      sh("rm", "-rf", File.join(OUTPUT_DIR, "logs")) if File.directory?(File.join(OUTPUT_DIR, "logs"))
    end
  end

  desc "SwiftUI الأصلي (SunnahApp): بناء + توقيع + TestFlight داخلي — محليًا فقط (1.2.0 / بناء ≥100)"
  lane :native_beta do
    key_path = File.expand_path(ENV.fetch("APP_STORE_CONNECT_API_KEY_PATH")) # .p8 خارج المستودع
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_API_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
      key_filepath: key_path, duration: 1200, in_house: false
    )
    app_id = ENV.fetch("APP_IDENTIFIER", "com.yousef.majlisilm")
    proj = File.join(PLATFORM_ROOT, "ios-native/SunnahApp.xcodeproj")
    out = File.join(PLATFORM_ROOT, "ios-native/build")
    latest = begin
      latest_testflight_build_number(api_key: api_key, app_identifier: app_id, initial_build_number: 0)
    rescue StandardError
      0
    end
    next_build = [latest.to_i + 1, 100].max
    UI.success("SunnahApp 1.2.0 build #{next_build}")
    increment_build_number(build_number: next_build, xcodeproj: proj)
    build_app(
      project: proj, scheme: "SunnahApp", clean: true, output_directory: out, output_name: "SunnahApp",
      export_method: "app-store",
      xcargs: "-allowProvisioningUpdates -authenticationKeyPath #{key_path}" \
              " -authenticationKeyID #{ENV.fetch('APP_STORE_CONNECT_API_KEY_ID')}" \
              " -authenticationKeyIssuerID #{ENV.fetch('APP_STORE_CONNECT_ISSUER_ID')}",
      export_options: { method: "app-store", signingStyle: "automatic", teamID: ENV.fetch("APPLE_TEAM_ID", "5D8TX37HTS") }
    )
    upload_to_testflight(
      api_key: api_key, app_identifier: app_id, ipa: File.join(out, "SunnahApp.ipa"),
      skip_waiting_for_build_processing: true, skip_submission: true,
      distribute_external: false, notify_external_testers: false,
      changelog: ENV["TESTFLIGHT_CHANGELOG"].to_s.strip.then { |c| c.empty? ? "SunnahApp native #{next_build}" : c }
    )
  end

  desc "SwiftUI الأصلي: يرفع ما الجديد وملاحظات المراجع ويختار البناء ويرسل للمراجعة. افتراضيًا dry-run (لا يلمس App Store Connect)؛ التنفيذ الفعلي فقط بـ submit=true"
  lane :native_release do |options|
    submit = options[:submit].to_s == "true"
    version = options[:version] || "1.2.0"
    store = File.join(PLATFORM_ROOT, "docs/native/store")
    block = lambda do |file, heading|
      txt = File.read(File.join(store, file), encoding: "UTF-8")
      m = txt.match(/^## #{Regexp.escape(heading)}[^\n]*\n+```[^\n]*\n(.*?)```/m)
      UI.user_error!("لم أجد كتلة «#{heading}» في #{file}") unless m
      m[1].strip
    end
    notes = {
      "ar-SA" => block.call("WHATS_NEW.md", "العربية"),
      "en-US" => block.call("WHATS_NEW.md", "English")
    }
    review = block.call("REVIEW_NOTES.md", "Notes")
    review = review.sub(/^Demo account:.*$/, "").strip
    meta = File.join(OUTPUT_DIR, "native-metadata")
    FileUtils.rm_rf(meta)
    notes.each do |loc, txt|
      UI.user_error!("release notes #{loc} تتجاوز 4000 حرف") if txt.length > 4000
      FileUtils.mkdir_p(File.join(meta, loc))
      File.write(File.join(meta, loc, "release_notes.txt"), txt)
    end
    FileUtils.mkdir_p(File.join(meta, "review_information"))
    File.write(File.join(meta, "review_information", "notes.txt"), review)
    demo_user = ENV["REVIEW_DEMO_USER"].to_s
    demo_pass = ENV["REVIEW_DEMO_PASSWORD"].to_s
    File.write(File.join(meta, "review_information", "demo_user.txt"), demo_user) unless demo_user.empty?
    File.write(File.join(meta, "review_information", "demo_password.txt"), demo_pass) unless demo_pass.empty?
    UI.message("الإصدار #{version} | اللغات: #{notes.keys.join(', ')} | ملاحظات المراجع #{review.length} حرفًا | حساب تجريبي: #{demo_user.empty? ? 'لا' : 'نعم'}")
    unless submit
      UI.important("DRY-RUN: لم يُرسل شيء إلى App Store Connect. للتنفيذ الفعلي: fastlane ios native_release submit:true [build:N]")
      next
    end
    key_path = File.expand_path(ENV.fetch("APP_STORE_CONNECT_API_KEY_PATH"))
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_API_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
      key_filepath: key_path, duration: 1200, in_house: false
    )
    app_id = ENV.fetch("APP_IDENTIFIER", "com.yousef.majlisilm")
    build = (options[:build] || latest_testflight_build_number(api_key: api_key, app_identifier: app_id, version: version)).to_s
    UI.important("اختيار البناء #{version} (#{build}) والإرسال للمراجعة")
    deliver(
      api_key: api_key, app_identifier: app_id, app_version: version, build_number: build,
      metadata_path: meta, skip_binary_upload: true, skip_screenshots: true, skip_app_version_update: false,
      submit_for_review: true, automatic_release: ENV["AUTOMATIC_RELEASE"].to_s == "true",
      force: true, run_precheck_before_submit: false,
      submission_information: { export_compliance_uses_encryption: false, add_id_info_uses_idfa: false }
    )
  end

  desc "Local archive smoke (no upload) — useful for CI dry-run on macOS"
  lane :build_only do
    Dir.chdir(IOS_WORKSPACE_DIR) do
      sh(
        "xcodebuild",
        "-resolvePackageDependencies",
        "-project", "App.xcodeproj",
        "-scheme", SCHEME
      )
    end

    build_app(
      project: IOS_PROJECT,
      scheme: SCHEME,
      clean: true,
      skip_package_ipa: true,
      skip_archive: false,
      destination: "generic/platform=iOS",
      xcargs: "CODE_SIGNING_ALLOWED=NO CODE_SIGNING_REQUIRED=NO CODE_SIGN_IDENTITY=''",
      output_directory: OUTPUT_DIR
    )
  end
end
